# ==============================================================================
# Git Ignore Configuration
# ==============================================================================

# 1. Local Environment Configuration & Secrets (CRITICAL)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# 2. Vercel Deployment & Build Metadata
.vercel
.vercel/

# 3. Node & Dependency Caches
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# 4. Build Outputs & Caches
dist/
build/
.next/
out/
.cache/

# 5. Internal Development Scripts & One-Off Tooling
scripts/
*.ps1

# 6. Operating System Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 7. Editor & IDE Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# 8. Temporary & Backup Files
*.log
*.tmp
*.bak
*.orig
